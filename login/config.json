{
  "serverId": null,
  "serverType": "login",

  "log": {
    "level": "DEBUG",
    "path": "./log",
    "isPrint": true,
    "maxBytes": 52428800,
    "backupCount": 30
  },

  "db": {
    "type": "postgres",
    "dsn": "postgresql://postgres:123456@127.0.0.1:5432/pygame"
  },

  "servers": {
    "1001": {
      "name": "一区·风起云涌",
      "gameNodes": {
        "game1": { "tcp": "127.0.0.1:21101", "ws": "127.0.0.1:21201" },
        "game2": { "tcp": "127.0.0.1:21102", "ws": "127.0.0.1:21202" }
      }
    },
    "1002": {
      "name": "二区·雷霆万钧",
      "gameNodes": {
        "game1": { "tcp": "127.0.0.1:22101", "ws": "127.0.0.1:22201" },
        "game2": { "tcp": "127.0.0.1:22102", "ws": "127.0.0.1:22202" }
      }
    }
  },

  "services": {
    "master": {
      "port": 11001,
      "app": "app.master",
      "cluster": {
        "clusterPort": 11000,
        "remoteAddrs": {
          "game1001": "127.0.0.1:21000",
          "game1002": "127.0.0.1:22000"
        }
      }
    },

    "login": {
      "port": 11002,
      "app": "app.login",
      "tcpServer": {
        "addr": "127.0.0.1:11100",
        "maxConnection": 2000
      },
      "wsServer": {
        "addr": "127.0.0.1:11200",
        "maxConnection": 2000
      }
    }
  }
}
