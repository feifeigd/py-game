{
  "serverId": null,
  "serverType": "login",

  "log": {
    "level": "DEBUG",
    "path": "./log",
    "isPrint": true,
    "maxBytes": 52428800,
    "backupCount": 30
  },

  "db": {
    "type": "postgres",
    "dsn": "postgresql://postgres:123456@127.0.0.1:5432/pygame"
  },

  "gameServers": {
    "game1": { "tcp": "127.0.0.1:21101", "ws": "127.0.0.1:21201" },
    "game2": { "tcp": "127.0.0.1:21102", "ws": "127.0.0.1:21202" }
  },

  "services": {
    "master": {
      "port": 11001,
      "app": "app.master",
      "cluster": {
        "clusterPort": 11000,
        "remoteAddrs": {
          "game": "127.0.0.1:21000"
        }
      }
    },

    "login": {
      "port": 11002,
      "app": "app.login",
      "tcpServer": {
        "addr": "127.0.0.1:11100",
        "maxConnection": 2000
      },
      "wsServer": {
        "addr": "127.0.0.1:11200",
        "maxConnection": 2000
      }
    }
  }
}
